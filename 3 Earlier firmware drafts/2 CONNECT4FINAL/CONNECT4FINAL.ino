    else if (reading > 300) col = 0;
    
    if (col != -1) {
         Serial.printf("DEBUG: Analog Read: %d -> Mapped to Column: %d\n", reading, col);
    }
    return col;
}

// =================================================================================
// 6. SETUP
// =================================================================================
void setup() {
  // Small delay to allow Serial to connect before potential crash
  delay(3000); 
  Serial.begin(115200);
  Serial.println("DEBUG: Starting Setup...");
  
  // 1. Initialize Hardware
  pixels.begin();
  pixels.setBrightness(20);
  pixels.show();
  analogReadResolution(12);
  
  if (!setupCamera()) {
    Serial.println("Camera Init Failed!");
    while(1);
  }
  Serial.println("Camera Initialized.");

  // 2. PSRAM Check
  if(psramFound()){
      Serial.printf("PSRAM Found. Size: %d bytes. Free: %d bytes.\n", ESP.getPsramSize(), ESP.getFreePsram());
      tensor_arena = (uint8_t*)ps_malloc(kArenaSize);
      if (tensor_arena == nullptr) {
          Serial.println("CRITICAL ERROR: ps_malloc failed to allocate arena! Out of PSRAM?");
          while(1);
      }
      Serial.println("Arena allocated in PSRAM");
  } else {
      Serial.println("CRITICAL WARNING: PSRAM not found! Attempting malloc in SRAM...");
      // If model is large, this WILL crash
      tensor_arena = (uint8_t*)malloc(kArenaSize);
      if (tensor_arena == nullptr) {
          Serial.println("CRITICAL ERROR: malloc failed! System out of memory.");
          while(1);
      }
  }

  // 3. Check Model Array
  Serial.printf("DEBUG: g_model_vision address: %p\n", g_model_vision);
  Serial.printf("DEBUG: First 8 bytes of model: %02X %02X %02X %02X %02X %02X %02X %02X\n", 
                g_model_vision[0], g_model_vision[1], g_model_vision[2], g_model_vision[3],
                g_model_vision[4], g_model_vision[5], g_model_vision[6], g_model_vision[7]);

  // Map the model
  model = tflite::GetModel(g_model_vision);
  if (model->version() != TFLITE_SCHEMA_VERSION) {
    Serial.printf("Model schema version mismatch! Expected: %d, Got: %d\n", TFLITE_SCHEMA_VERSION, model->version());
    while(1);
  }
  Serial.println("DEBUG: Model Loaded");

  // Setup Ops Resolver
  // INCREASED SIZE to accommodate extra quantized ops
  static tflite::MicroMutableOpResolver<25> op_resolver; // Increased from 20 to 25
  
  // Standard Ops
  op_resolver.AddConv2D();
  op_resolver.AddMaxPool2D();
  op_resolver.AddFullyConnected();
  op_resolver.AddSoftmax();
  op_resolver.AddReshape();
  op_resolver.AddRelu();
  
  // REQUIRED for Quantized Models:
  op_resolver.AddQuantize();
  op_resolver.AddDequantize();
  
  // Helper Ops often inserted by TFLite Converter
  op_resolver.AddPad(); 
  op_resolver.AddAdd();
  op_resolver.AddMul();
  op_resolver.AddSub();
  op_resolver.AddMean(); 
  op_resolver.AddConcatenation();
  
  // **FIX FOR YOUR ERROR:**
  op_resolver.AddShape();        // <--- This was the missing op
  op_resolver.AddStridedSlice(); // Commonly appears with Shape/Reshape
  op_resolver.AddPack();         // Sometimes used in reshaping
  op_resolver.AddSplit();        // Sometimes used in reshaping

  // Build Interpreter
  static tflite::MicroInterpreter static_interpreter(
      model, op_resolver, tensor_arena, kArenaSize);
  interpreter = &static_interpreter;

  // Allocate Tensors
  Serial.println("DEBUG: Attempting to allocate tensors...");
  TfLiteStatus allocate_status = interpreter->AllocateTensors();
  if (allocate_status != kTfLiteOk) {
    Serial.println("AllocateTensors() failed!");
    // Since we don't have error reporter, try printing to check if model loaded
    if (model == nullptr) Serial.println("Model is null");
    while(1);
  }
  Serial.println("DEBUG: Tensors Allocated Successfully");

  input_tensor = interpreter->input(0);
  output_tensor = interpreter->output(0);
  
  Serial.println("AI System Ready. Waiting for Red move...");
}

// =================================================================================
// 7. MAIN LOOP
// =================================================================================
void loop() {
    int btn = getColumnFromVoltage();
    
    if (btn != -1 && !isButtonHeld) {
        Serial.printf("DEBUG: Initial button detect col %d. Debouncing...\n", btn);
        // Debounce
        delay(50);
        int verifiedColumn = getColumnFromVoltage();
        Serial.printf("DEBUG: Verified column: %d\n", verifiedColumn);
        
        if (verifiedColumn == btn) {
            isButtonHeld = true;
            Serial.printf("Player Move Detected in Column: %d\n", verifiedColumn);
            
            // --- 1. INSTANT PLAYER FEEDBACK (Manual Logic) ---
            int manualPlacedRow = -1;
            if (colHeights[verifiedColumn] < 8) {
                manualPlacedRow = colHeights[verifiedColumn];
                boardState[verifiedColumn][manualPlacedRow] = 1; // 1 = Red (Player)
                Serial.printf("DEBUG: Manually adding Red piece at Col %d, Row %d\n", verifiedColumn, manualPlacedRow);
            } else {
                Serial.println("DEBUG: Column is full! Cannot add piece.");
            }
            
            // Update the physical board IMMEDIATELY so player sees their move
            updatePhysicalBoard();
            
            // Wait a brief moment to simulate the piece dropping
            delay(500);

            // --- 2. VISION MODEL: VERIFICATION ---
            Serial.println("Scanning Board with Camera...");
            camera_fb_t* fb = esp_camera_fb_get();
            if (!fb) {
                Serial.println("Camera capture failed");
                return;
            }
            Serial.println("DEBUG: Frame captured");

            // Preprocess and fill input tensor
            processImageToModelInput(fb);
            esp_camera_fb_return(fb);
            Serial.println("DEBUG: Frame buffer returned");

            // Run Inference
            Serial.println("DEBUG: Invoking Interpreter...");
            if (interpreter->Invoke() != kTfLiteOk) {
                Serial.println("Inference failed");
                return;
            }
            Serial.println("DEBUG: Inference Success");

            // --- 3. VISION MODEL: SYNC STATE ---
            // Output shape: (1, 64, 3) INT8
            int8_t* out_data = output_tensor->data.int8;
            
            Serial.println("DEBUG: Updating Board State from Vision Model...");
            // We update boardState with what the AI *actually* sees
            // This corrects any manual mistakes or missed pieces
            for (int i = 0; i < 64; i++) {
                int8_t p0 = out_data[i*3 + 0]; // Empty
                int8_t p1 = out_data[i*3 + 1]; // Red
                int8_t p2 = out_data[i*3 + 2]; // Blue
                
                int r = i / 8;
                int c = i % 8;

                if (p0 > p1 && p0 > p2) boardState[c][r] = 0;
                else if (p1 > p0 && p1 > p2) boardState[c][r] = 1;
                else boardState[c][r] = 2;
            }
            
            // --- 3b. CORRECTION LOGIC ---
            // If we manually placed a piece, but the model says it's Empty (0),
            // we override the model. The LED helps the user, but the camera might miss it.
            if (manualPlacedRow != -1) {
                 if (boardState[verifiedColumn][manualPlacedRow] == 0) {
                      Serial.printf("DEBUG: Model missed the move at [%d][%d]. Forcing Red piece.\n", verifiedColumn, manualPlacedRow);
                      boardState[verifiedColumn][manualPlacedRow] = 1;
                 }
            }
            
            Serial.println("DEBUG: Board State Synced.");
            
            // Update board again in case model made corrections (or we forced correction)
            updatePhysicalBoard(); 
            
            // --- 4. MOVE PREDICTION MODEL (GAME AI) ---
            Serial.println("Calculating AI Move...");
            int aiMoveCol = predictBestMove(boardState, colHeights, 2);
            
            if (aiMoveCol != -1) {
                Serial.printf("AI chooses column: %d\n", aiMoveCol);
                int row = colHeights[aiMoveCol];
                if(row < 8) {
                    boardState[aiMoveCol][row] = 2; // Place Blue
                    Serial.printf("DEBUG: AI placing Blue piece at Col %d, Row %d\n", aiMoveCol, row);
                    updatePhysicalBoard(); // Update again after AI move
                } else {
                    Serial.println("DEBUG: AI attempted to place in full column");
                }
            } else {
                Serial.println("AI could not find a move (Board full?)");
            }
        } else {
            Serial.println("DEBUG: Debounce failed (signal unstable)");
        }
    } else if (btn == -1) {
        if (isButtonHeld) {
             Serial.println("DEBUG: Button released.");
        }
        isButtonHeld = false;
    }
    
    delay(10);
}