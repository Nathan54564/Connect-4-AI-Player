// Convert 565 RGB to INT8 for Quantized Model
void processImageToModelInput(camera_fb_t* fb) {
    Serial.println("DEBUG: Processing Image to Model Input...");
    if (input_tensor == nullptr) {
        Serial.println("ERROR: input_tensor is null!");
        return;
    }

    // Get input tensor parameters for quantization
    // These values tell us how to convert real float values to int8
    float input_scale = input_tensor->params.scale;
    int32_t input_zero_point = input_tensor->params.zero_point;

    // Get pointer to input data (int8_t for quantized model)
    int8_t* input_data = input_tensor->data.int8;

    int src_width = fb->width;
    int src_height = fb->height;
    int crop_size = (src_width < src_height) ? src_width : src_height; 
    int start_x = (src_width - crop_size) / 2;
    int start_y = (src_height - crop_size) / 2;

    for (int y = 0; y < IMG_HEIGHT; y++) {
        for (int x = 0; x < IMG_WIDTH; x++) {
            int src_x = start_x + (x * crop_size / IMG_WIDTH);
            int src_y = start_y + (y * crop_size / IMG_HEIGHT);
            int src_idx = (src_y * src_width + src_x) * 2;

            uint8_t low = fb->buf[src_idx];
            uint8_t high = fb->buf[src_idx + 1];
            uint16_t pixel = (high << 8) | low;

            // Extract RGB (0-255 range)
            uint8_t r = (pixel >> 11) & 0x1F; r = (r * 255) / 31;
            uint8_t g = (pixel >> 5) & 0x3F;  g = (g * 255) / 63;
            uint8_t b = pixel & 0x1F;         b = (b * 255) / 31;

            // Convert 0-255 RGB to 0.0-1.0 Float, then to Int8
            // Formula: Quantized = (Real_Value / Scale) + Zero_Point
            
            float r_norm = r / 255.0f;
            float g_norm = g / 255.0f;
            float b_norm = b / 255.0f;

            int tensor_idx = (y * IMG_WIDTH + x) * IMG_CHANNELS;

            input_data[tensor_idx + 0] = (int8_t)(r_norm / input_scale + input_zero_point);
            input_data[tensor_idx + 1] = (int8_t)(g_norm / input_scale + input_zero_point);
            input_data[tensor_idx + 2] = (int8_t)(b_norm / input_scale + input_zero_point);
        }
    }
    Serial.println("DEBUG: Image processing complete.");
}

void setZigZagPixel(int col, int row, uint32_t color) {
    int pixelIndex;
    if (row % 2 == 0) {
        pixelIndex = (row * 8) + col;
    } else {
        pixelIndex = (row * 8) + (7 - col);
    }
    pixels.setPixelColor(pixelIndex, color);
}

void updatePhysicalBoard() {
    Serial.println("DEBUG: Updating Physical LED Matrix...");
    pixels.clear();
    // We also recalculate column heights here to ensure AI has correct data
    for(int c=0; c<8; c++) {
        colHeights[c] = 0; 
        for(int r=0; r<8; r++) {
            uint8_t cell = boardState[c][r];
            if(cell == 1) { // Red
                setZigZagPixel(c, r, pixels.Color(150, 0, 0));
                colHeights[c]++;
            } else if (cell == 2) { // Blue (AI)
                setZigZagPixel(c, r, pixels.Color(0, 0, 150));
                colHeights[c]++;
            } else {
                setZigZagPixel(c, r, pixels.Color(0, 0, 0));
            }
        }
    }
    pixels.show();
    Serial.println("DEBUG: LEDs updated.");
}

