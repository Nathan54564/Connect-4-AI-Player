// Heuristic AI to pick the best column
// Returns 0-7 for the column index, or -1 if full
int predictBestMove(uint8_t board[8][8], int colHeights[8], int aiColor) {
    Serial.println("DEBUG: predictBestMove() called");
    int bestCol = -1;
    int maxScore = -10000;

    // Iterate through all possible columns
    for (int col = 0; col < 8; col++) {
        if (colHeights[col] >= 8) {
             Serial.printf("DEBUG: Col %d is full, skipping\n", col);
             continue; // Column full
        }

        // Score based on centrality (Center columns are better in Connect 4)
        int score = 0;
        if (col == 3 || col == 4) score += 5;
        if (col == 2 || col == 5) score += 2;
        
        // Randomness to make it feel "alive"
        int randVal = random(0, 3);
        score += randVal;
        
        Serial.printf("DEBUG: Evaluating Col %d: Base Score=%d, Random=%d, Total=%d\n", col, score - randVal, randVal, score);

        if (score > maxScore) {
            maxScore = score;
            bestCol = col;
        }
    }
    
    // Fallback if no valid move found via score
    if (bestCol == -1) {
        Serial.println("DEBUG: No best move found via score, looking for any valid move");
        for(int i=0; i<8; i++) if(colHeights[i] < 8) {
             Serial.printf("DEBUG: Fallback selected col %d\n", i);
             return i;
        }
    }
    
    Serial.printf("DEBUG: predictBestMove returning %d\n", bestCol);
    return bestCol;
}

